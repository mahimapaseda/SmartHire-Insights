# SmartHire Insights — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Backend ───────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# API key shared between frontend and backend
SH_API_KEY=sh_secret_key_2026

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" only in development
FLASK_DEBUG=false

# ── Frontend (Vite) ───────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_API_SECRET=sh_secret_key_2026
VITE_DEMO_EMAIL=mahima@smarthire.ai
VITE_DEMO_KEY=admin123
